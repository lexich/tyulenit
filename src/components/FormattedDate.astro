---
import { useI18n } from '../i18n';

interface Props {
  date: Date;
}

const { locale } = useI18n(Astro.url);

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locale, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }
</time>
